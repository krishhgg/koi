{
	"name": "koi",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/*",
		"host/recorder"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p host/recorder/tsconfig.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test --preload ./scripts/test-tmpdir.ts --timeout 30000"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
